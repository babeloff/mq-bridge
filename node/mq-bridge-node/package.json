{
  "name": "mq-bridge",
  "version": "0.2.20",
  "description": "Node.js bindings for mq-bridge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcomq/mq-bridge.git",
    "directory": "node/mq-bridge-node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "mq_bridge_node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --strip --js native.js --dts native.d.ts",
    "build:basic": "napi build --platform --release --strip --no-default-features --features \"basic middleware\" --js native.js --dts native.d.ts",
    "build:ci": "napi build --platform --no-default-features --features \"http middleware schema\" --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "example": "node examples/http-handler.js",
    "test": "node --test test/*.test.js",
    "sync-version": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
